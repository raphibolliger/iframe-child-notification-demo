{
  "name": "iframe-child-notification-demo",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -n parent,child -c blue,magenta \"ng serve parent\" \"ng serve child\"",
    "start:parent": "ng serve parent",
    "start:child": "ng serve child",
    "build": "ng build parent && ng build child"
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/cdk": "~21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "~21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "iframe-resizer": "4.4.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.0",
    "concurrently": "^9.2.5",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  }
}
