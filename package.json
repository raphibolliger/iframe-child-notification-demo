{
  "name": "iframe-child-notification-demo",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -n parent,child -c blue,magenta \"ng serve parent\" \"ng serve child\"",
    "start:parent": "ng serve parent",
    "start:child": "ng serve child",
    "build": "ng build parent && ng build child"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/cdk": "~22.2.5",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "~22.2.5",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@iframe-resizer/child": "^5.5.9",
    "@iframe-resizer/parent": "^5.5.9",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.3",
    "concurrently": "^9.2.5",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3"
  }
}
